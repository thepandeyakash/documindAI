# Copy this file to .env for local development, then fill in the values.
# NEVER commit a real .env file (it is gitignored). In production, set these
# variables in your platform's secret store (Railway variables / Streamlit
# Community Cloud secrets.toml), not in a file.

# ── Google Gemini ────────────────────────────────────────────────────────────
# Google Gemini API key (free tier is enough) used for embeddings and answer generation.
# Create one (free) at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_me

# ── Qdrant vector store ──────────────────────────────────────────────────────
# Local Docker by default. For Qdrant Cloud, set the cluster URL
# (https://<cluster>.qdrant.io) and an API key from the Qdrant Cloud console.
# Leave QDRANT_API_KEY empty for local Qdrant. Never commit real values.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Inngest ──────────────────────────────────────────────────────────────────
# Local development switch: INNGEST_DEV=1 routes events to the dev server on
# localhost:8288 (no keys needed). Leave this UNSET in production so the SDK
# uses Inngest Cloud.
INNGEST_DEV=1

# Production only (Inngest Cloud), set in Railway and/or Streamlit Community
# Cloud secrets — do NOT uncomment in a local .env:
# - INNGEST_EVENT_KEY: event key of the target Inngest environment; lets the
#   Streamlit app send events. Dashboard: Environment -> Event Keys.
# - INNGEST_SIGNING_KEY: signing key of the SAME environment. The FastAPI app
#   uses it to verify requests from Inngest Cloud; the Streamlit app uses it as
#   a bearer token against the Inngest REST API when polling run status/output.
# - INNGEST_API_BASE: Inngest REST API base polled by Streamlit for run status.
# - INNGEST_ENV: Inngest environment name. Set to the SAME value on the FastAPI
#   and Streamlit apps (e.g. "production") so events route to the environment
#   where the functions are synced.
# INNGEST_EVENT_KEY=replace_me
# INNGEST_SIGNING_KEY=replace_me
# INNGEST_API_BASE=https://api.inngest.com/v1
# INNGEST_ENV=production

# ── Streamlit frontend (production only) ─────────────────────────────────────
# Public URL of the deployed FastAPI backend, e.g. https://<service>.up.railway.app.
# When set, the Streamlit app uploads PDFs to <BACKEND_URL>/upload (the ingest
# function runs on the backend host and can only read files stored there).
# Leave unset for local development (files are saved next to the Streamlit app).
# BACKEND_URL=

# ── FastAPI server binding (optional) ────────────────────────────────────────
# Only used by `python main.py`. Railway supplies PORT automatically; the app
# binds 0.0.0.0 so the platform can route traffic to it.
# HOST=0.0.0.0
# PORT=8000

# ── Advanced (optional) ──────────────────────────────────────────────────────
# Where the FastAPI backend stores uploaded PDFs (default: ./uploads next to
# main.py). Point at a mounted volume for durable storage.
# UPLOAD_DIR=uploads
